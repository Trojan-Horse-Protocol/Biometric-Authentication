// AdminUIView.tsx
import React, { useCallback, useEffect, useMemo, useState } from "react";

export type UserRole = "member" | "admin";

export interface AdminUser {
  id: number;
  username: string;
  role: UserRole;
  passkey_count: number;
}

export interface AuditLogEntry {
  id: number;
  username?: string | null;
  event: string;
  success: boolean;
  ip?: string | null;
  detail?: string | null;
  created_at: string;
}

interface AdminUIViewProps {
  currentUserRole?: string | null;
  apiBaseUrl?: string;
  getAuthHeaders?: () => Record<string, string>;
}

const ROLE_OPTIONS: UserRole[] = ["member", "admin"];

// ============================================================================
// Admin UI View (only admin should be able to see API)
// ============================================================================
export default function AdminUIView({
  currentUserRole,
  apiBaseUrl = "",
  getAuthHeaders,
}: AdminUIViewProps) {
  const [users, setUsers] = useState<AdminUser[]>([]);
  const [auditLogs, setAuditLogs] = useState<AuditLogEntry[]>([]);
  const [roleDrafts, setRoleDrafts] = useState<Record<number, UserRole>>({});
  const [savingUserId, setSavingUserId] = useState<number | null>(null);

  const [searchQuery, setSearchQuery] = useState("");
  const [userFilter, setUserFilter] = useState<string>("all");
  const [auditLimit, setAuditLimit] = useState<number>(100);

  const [loading, setLoading] = useState(false);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);
  const [statusMessage, setStatusMessage] = useState<string | null>(null);

  const isAdmin = currentUserRole === "admin";

  const buildHeaders = useCallback(
    (includeJson = false): HeadersInit => ({
      ...(includeJson ? { "Content-Type": "application/json" } : {}),
      ...(getAuthHeaders ? getAuthHeaders() : {}),
    }),
    [getAuthHeaders]
  );

  // Admin UI View API fetch: list users & view authentication history (admin only)
  const loadAdminData = useCallback(async () => {
    if (!isAdmin) return;

    setLoading(true);
    setErrorMessage(null);

    try {
      const clampedLimit = Math.max(1, Math.min(auditLimit, 500));
      const [usersRes, auditRes] = await Promise.all([
        fetch(`${apiBaseUrl}/admin/users`, {
          credentials: "include",
          headers: buildHeaders(false),
        }),
        fetch(`${apiBaseUrl}/admin/audit?limit=${clampedLimit}`, {
          credentials: "include",
          headers: buildHeaders(false),
        }),
      ]);

      if (usersRes.status === 403 || auditRes.status === 403) {
        setErrorMessage("Admin privileges required.");
        return;
      }
      if (!usersRes.ok) {
        throw new Error(`Failed to load users (${usersRes.status})`);
      }
      if (!auditRes.ok) {
        throw new Error(`Failed to load authentication history (${auditRes.status})`);
      }

      const usersData: AdminUser[] = await usersRes.json();
      const auditData: AuditLogEntry[] = await auditRes.json();

      setUsers(usersData);
      setAuditLogs(auditData);

      const nextDrafts: Record<number, UserRole> = {};
      for (const u of usersData) {
        nextDrafts[u.id] = u.role === "admin" ? "admin" : "member";
      }
      setRoleDrafts(nextDrafts);
    } catch (err) {
      setErrorMessage(
        err instanceof Error ? err.message : "Failed to load admin data"
      );
    } finally {
      setLoading(false);
    }
  }, [apiBaseUrl, auditLimit, buildHeaders, isAdmin]);

  useEffect(() => {
    if (isAdmin) {
      void loadAdminData();
    } else {
      setUsers([]);
      setAuditLogs([]);
    }
  }, [isAdmin, loadAdminData]);

  // Only admin should be able to see API / Admin UI View
  if (!isAdmin) {
    return null;
  }

  // change roles API call
  const handleSaveRole = async (user: AdminUser) => {
    const nextRole = roleDrafts[user.id] ?? user.role;
    if (nextRole === user.role) return;

    setSavingUserId(user.id);
    setErrorMessage(null);
    setStatusMessage(null);

    try {
      const res = await fetch(`${apiBaseUrl}/admin/users/${user.id}/role`, {
        method: "PATCH",
        credentials: "include",
        headers: buildHeaders(true),
        body: JSON.stringify({ role: nextRole }),
      });

      const data = await res.json().catch(() => null);
      if (!res.ok) {
        throw new Error(data?.detail || `Failed to update role (${res.status})`);
      }

      const updatedRole: UserRole = data?.role === "admin" ? "admin" : "member";
      setUsers((prev) =>
        prev.map((item) =>
          item.id === user.id ? { ...item, role: updatedRole } : item
        )
      );
      setRoleDrafts((prev) => ({ ...prev, [user.id]: updatedRole }));
      setStatusMessage(`Updated ${user.username} to "${updatedRole}".`);
      void loadAdminData();
    } catch (err) {
      setErrorMessage(err instanceof Error ? err.message : "Role update failed");
    } finally {
      setSavingUserId(null);
    }
  };

  const filteredUsers = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    if (!q) return users;
    return users.filter(
      (u) =>
        u.username.toLowerCase().includes(q) ||
        u.role.toLowerCase().includes(q) ||
        String(u.id).includes(q)
    );
  }, [users, searchQuery]);

  const filteredLogs = useMemo(() => {
    if (userFilter === "all") return auditLogs;
    return auditLogs.filter((entry) => (entry.username ?? "") === userFilter);
  }, [auditLogs, userFilter]);

  return (
    <section
      style={{
        maxWidth: 980,
        margin: "0 auto",
        padding: 24,
        fontFamily: "system-ui, sans-serif",
      }}
    >
      {/* Admin UI View */}
      <header
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          marginBottom: 20,
          gap: 12,
          flexWrap: "wrap",
        }}
      >
        <div>
          <h1 style={{ margin: 0, fontSize: "1.5rem" }}>Admin UI View</h1>
          <p style={{ margin: "4px 0 0", color: "#555", fontSize: "0.9rem" }}>
            List users, change roles, and view authentication history.
          </p>
        </div>

        <button
          type="button"
          onClick={() => void loadAdminData()}
          disabled={loading}
          style={{ padding: "8px 14px", cursor: loading ? "not-allowed" : "pointer" }}
        >
          {loading ? "Refreshing..." : "Refresh"}
        </button>
      </header>

      {errorMessage && (
        <div
          role="alert"
          style={{
            padding: "10px 14px",
            marginBottom: 16,
            backgroundColor: "#fee2e2",
            color: "#991b1b",
            borderRadius: 6,
          }}
        >
          {errorMessage}
        </div>
      )}

      {statusMessage && (
        <div
          role="status"
          style={{
            padding: "10px 14px",
            marginBottom: 16,
            backgroundColor: "#dcfce7",
            color: "#166534",
            borderRadius: 6,
          }}
        >
          {statusMessage}
        </div>
      )}

      {/* list users */}
      <div style={{ marginBottom: 32 }}>
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            marginBottom: 12,
            gap: 12,
            flexWrap: "wrap",
          }}
        >
          <h2 style={{ margin: 0, fontSize: "1.15rem" }}>
            Users ({filteredUsers.length})
          </h2>
          <input
            type="search"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Filter by username or role..."
            aria-label="Filter users"
            style={{ padding: "6px 10px", minWidth: 220 }}
          />
        </div>

        <div style={{ overflowX: "auto" }}>
          <table style={{ width: "100%", borderCollapse: "collapse", textAlign: "left" }}>
            <thead>
              <tr style={{ borderBottom: "2px solid #e5e7eb" }}>
                <th style={{ padding: "10px 8px" }}>ID</th>
                <th style={{ padding: "10px 8px" }}>Username</th>
                <th style={{ padding: "10px 8px" }}>Role</th>
                <th style={{ padding: "10px 8px" }}>Passkeys</th>
                <th style={{ padding: "10px 8px" }}>Change Role</th>
              </tr>
            </thead>
            <tbody>
              {filteredUsers.map((u) => {
                const draftRole = roleDrafts[u.id] ?? u.role;
                const isDirty = draftRole !== u.role;
                const isSaving = savingUserId === u.id;

                return (
                  <tr key={u.id} style={{ borderBottom: "1px solid #f0f0f0" }}>
                    <td style={{ padding: "10px 8px" }}>{u.id}</td>
                    <td style={{ padding: "10px 8px", fontWeight: 500 }}>{u.username}</td>
                    <td style={{ padding: "10px 8px" }}>{u.role}</td>
                    <td style={{ padding: "10px 8px" }}>{u.passkey_count}</td>

                    {/* change roles */}
                    <td style={{ padding: "10px 8px" }}>
                      <div style={{ display: "flex", gap: 8, alignItems: "center" }}>
                        <select
                          aria-label={`Role for ${u.username}`}
                          value={draftRole}
                          disabled={isSaving}
                          onChange={(e) =>
                            setRoleDrafts((prev) => ({
                              ...prev,
                              [u.id]: e.target.value as UserRole,
                            }))
                          }
                          style={{ padding: "5px 8px" }}
                        >
                          {ROLE_OPTIONS.map((roleOpt) => (
                            <option key={roleOpt} value={roleOpt}>
                              {roleOpt}
                            </option>
                          ))}
                        </select>
                        <button
                          type="button"
                          disabled={!isDirty || isSaving}
                          onClick={() => void handleSaveRole(u)}
                          style={{
                            padding: "5px 10px",
                            cursor: isDirty && !isSaving ? "pointer" : "not-allowed",
                          }}
                        >
                          {isSaving ? "Saving..." : "Save"}
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      {/* view authentication history */}
      <div>
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            marginBottom: 12,
            gap: 12,
            flexWrap: "wrap",
          }}
        >
          <h2 style={{ margin: 0, fontSize: "1.15rem" }}>
            Authentication History ({filteredLogs.length})
          </h2>

          <div style={{ display: "flex", gap: 12, alignItems: "center", flexWrap: "wrap" }}>
            <label style={{ display: "flex", alignItems: "center", gap: 6, fontSize: "0.9rem" }}>
              <span>User:</span>
              <select
                value={userFilter}
                onChange={(e) => setUserFilter(e.target.value)}
                style={{ padding: "6px 8px" }}
              >
                <option value="all">All users</option>
                {users.map((u) => (
                  <option key={u.id} value={u.username}>
                    {u.username}
                  </option>
                ))}
              </select>
            </label>

            <label style={{ display: "flex", alignItems: "center", gap: 6, fontSize: "0.9rem" }}>
              <span>Limit:</span>
              <select
                value={auditLimit}
                onChange={(e) => setAuditLimit(Number(e.target.value))}
                style={{ padding: "6px 8px" }}
              >
                <option value={25}>25</option>
                <option value={100}>100</option>
                <option value={250}>250</option>
                <option value={500}>500</option>
              </select>
            </label>
          </div>
        </div>

        <div style={{ overflowX: "auto" }}>
          <table style={{ width: "100%", borderCollapse: "collapse", textAlign: "left" }}>
            <thead>
              <tr style={{ borderBottom: "2px solid #e5e7eb" }}>
                <th style={{ padding: "10px 8px" }}>Event</th>
                <th style={{ padding: "10px 8px" }}>User</th>
                <th style={{ padding: "10px 8px" }}>Status</th>
                <th style={{ padding: "10px 8px" }}>IP</th>
                <th style={{ padding: "10px 8px" }}>Detail</th>
                <th style={{ padding: "10px 8px" }}>Time</th>
              </tr>
            </thead>
            <tbody>
              {filteredLogs.map((entry) => (
                <tr key={entry.id} style={{ borderBottom: "1px solid #f0f0f0" }}>
                  <td style={{ padding: "10px 8px", fontFamily: "monospace" }}>{entry.event}</td>
                  <td style={{ padding: "10px 8px" }}>{entry.username || "—"}</td>
                  <td style={{ padding: "10px 8px" }}>
                    <span
                      style={{
                        padding: "2px 8px",
                        borderRadius: 999,
                        fontSize: "0.8rem",
                        backgroundColor: entry.success ? "#dcfce7" : "#fee2e2",
                        color: entry.success ? "#166534" : "#991b1b",
                      }}
                    >
                      {entry.success ? "Success" : "Failed"}
                    </span>
                  </td>
                  <td style={{ padding: "10
